# Copy to .env to override the docker-compose defaults. .env is gitignored.

# Host port the app is published on → http://localhost:<port>/
# (8088 by default — 8080 is commonly taken by Adminer/other tools.)
DBLIB_HTTP_PORT=8088

# Show PHP stack traces (dev only). Leave false for anything shared.
DBLIB_DEBUG=false

# MariaDB root password (kept localhost-only inside the db container).
DBLIB_DB_ROOT_PASS=rootpass

# Provisioning account the app uses (CREATE DATABASE / USER / GRANT). Created
# network-reachable by docker/initdb. Change both for anything non-local.
DBLIB_DB_ADMIN_USER=dblib_admin
DBLIB_DB_ADMIN_PASS=dblib_admin_pw

# First teacher login, created on first boot. Sign in with this email.
DBLIB_TEACHER_EMAIL=teacher@dblib.local
DBLIB_TEACHER_PASSWORD=changeme
DBLIB_TEACHER_NAME=Teacher
